LLM_PROVIDER=google_genai        # google_genai | openai | azure_openai | anthropic
LLM_MODEL=gemini-2.5-flash       # dev model; evals may use a stronger one
GOOGLE_API_KEY=                  # or OPENAI_API_KEY / AZURE_OPENAI_API_KEY + AZURE_OPENAI_ENDPOINT
DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/app
MONTHLY_BUDGET_USD=20
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
DB_CONNECT_TIMEOUT_S=10
